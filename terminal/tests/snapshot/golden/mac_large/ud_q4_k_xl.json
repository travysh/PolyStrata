{
 "machine": "mac_large",
 "set": "ud_q4_k_xl",
 "entries": {
  "setup": {
   "entry": "setup",
   "command": "strata setup --family unsloth --model UD-Q4_K_XL --yes --no-start",
   "not_driven": "Mac: setup.py hands over to metal/setup_mac.py (mac_setup) and, for DeepSeek, to mac_dsv41_setup(); they write their own configs; not behind a seam yet"
  },
  "launch": {
   "entry": "launch",
   "command": "strata launch --model UD-Q4_K_XL --yes --no-tui --context 131072",
   "fetches": [
    {
     "call": "ensure_tuned",
     "file": "qwen3.8-flash-next-dflash2.strata1.q4_0-selq4.pack",
     "variant": "selq4",
     "backend": "metal",
     "gb": 0.34
    }
   ],
   "setup_args": [
    "--yes",
    "--no-start",
    "--family",
    "unsloth",
    "--model",
    "UD-Q4_K_XL",
    "--context",
    "131072",
    "--vision",
    "gpu",
    "--drafter",
    "dflash2",
    "--data-dir",
    "<ROOT>/data"
   ],
   "config_file": {
    "exe": "<ROOT>/engine/strata",
    "args": [
     "--pack",
     "<ROOT>/data/packs/ud_q4_k_xl",
     "--native",
     "<ROOT>/data/models/UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00003.gguf",
     "--expert-profile",
     "<REPO>/data/expert-profile.bin",
     "--expert-cache",
     "auto",
     "--prefill",
     "auto",
     "--spec",
     "4",
     "--spec-min-p",
     "0.5",
     "--mtp",
     "<ROOT>/data/mtp/rt",
     "--max-context",
     "131072",
     "--kv",
     "int8",
     "--resident-budget-gib",
     "48"
    ],
    "cwd": "<REPO>",
    "tokenizer": "<ROOT>/data/packs/ud_q4_k_xl/tokenizer",
    "model_name": "qwen3.8-flash-next-unsloth-ud-q4_k_xl",
    "log": "<ROOT>/<STATE>/launch/ud-q4_k_xl-128k.engine.log",
    "lib_dirs": [],
    "port": 8080,
    "backend": "metal",
    "host": "127.0.0.1",
    "open_browser": false,
    "engine_ready_s": 1230,
    "args_derived": "=args",
    "args_written": "=args"
   },
   "engine": {
    "exe": "<ROOT>/engine/strata",
    "argv": [
     "--pack",
     "<ROOT>/data/packs/ud_q4_k_xl",
     "--native",
     "<ROOT>/data/models/UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00003.gguf",
     "--expert-profile",
     "<REPO>/data/expert-profile.bin",
     "--expert-cache",
     "auto",
     "--prefill",
     "auto",
     "--max-context",
     "131072",
     "--kv",
     "int8",
     "--resident-budget-gib",
     "48",
     "--draft",
     "dflash2",
     "--draft-model",
     "<ROOT>/data/dflash2/qwen3.8-flash-next-dflash2.strata1.q4_0-selq4.pack",
     "--draft-fallback",
     "none",
     "--mtp-draft-vocab",
     "<ROOT>/data/mtp/rt/draft_vocab.bin",
     "--spec",
     "6",
     "--draft-conf",
     "0.7"
    ],
    "env_set": {
     "GGML_NO_BACKTRACE": "1",
     "STRATA_ROUTE_TAIL_SKIP": "0"
    },
    "notes": [
     "[strata] drafting: DFlash2 alone (--draft dflash2, --draft-conf 0.7)",
     "[strata] drafting: draft vocabulary: draft_vocab.bin (the default)"
    ]
   }
  }
 }
}
