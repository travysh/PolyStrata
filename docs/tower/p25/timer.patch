 // A layer from its input to its router's copy: the attention, the block's residual, and the experts' input.
+// PROFILE ONLY (not committed): STRATA_INK_TIME=1 times a token's layer heads on the GPU (events) and the host
+// (rdtsc), printed every 2048 heads.
+namespace {
+struct HeadTimer {
+    bool on = std::getenv("STRATA_INK_TIME") != nullptr;
+    cudaEvent_t e[4] = {};
+    double gpu[2][3] = {}, host[2] = {};
+    long cnt[2] = {};
+    unsigned long long t0 = 0;
+    void rec(int i, void* st) {
+        if (!e[0]) for (auto& x : e) cudaEventCreate(&x);
+        cudaEventRecord(e[i], (cudaStream_t) st);
+    }
+    void done(int kind, int last) {   // kind 0 plain, 1 index; events 0..last
+        const unsigned long long t1 = __builtin_ia32_rdtsc();
+        cudaEventSynchronize(e[last]);
+        host[kind] += (double) (t1 - t0);
+        for (int i = 0; i < last; ++i) { float ms = 0; cudaEventElapsedTime(&ms, e[i], e[i + 1]); gpu[kind][i] += ms; }
+        if (++cnt[kind] % 2048 == 0)
+            std::fprintf(stderr, "headtime %s n=%ld gpu us: %.1f %.1f %.1f host enqueue us: %.1f (at 3.6 GHz)\n",
+                         kind ? "zha" : "plain", cnt[kind], 1e3 * gpu[kind][0] / cnt[kind], 1e3 * gpu[kind][1] / cnt[kind],
+                         1e3 * gpu[kind][2] / cnt[kind], host[kind] / 3.6e3 / cnt[kind]);
+    }
+};
+HeadTimer g_ht;
+}  // namespace
